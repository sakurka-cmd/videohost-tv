<?xml version="1.0" encoding="utf-8"?>
<!--
  PlayerView with TextureView surface type.

  VONTAR H1 (Allwinner H6) has a known issue: SurfaceView inside Compose
  AndroidView doesn't render — black screen, only audio.
  TextureView renders correctly on all devices (slightly less efficient,
  but works everywhere). X4 and emulators work with either.

  This layout is inflated in PlayerScreen.kt via AndroidView factory.
-->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:shutter_background_color="#000000" />
